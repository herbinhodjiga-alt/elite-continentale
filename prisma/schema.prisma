generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id            Int      @id @default(autoincrement())
  ref           String   @unique
  nom           String
  prenom        String
  ddn           DateTime
  lieuNaissance String
  tel           String
  categorie     String
  region        String
  ville         String
  club          String?  
  pdfPath       String?
  pdfName       String?
  createdAt     DateTime @default(now())
}
